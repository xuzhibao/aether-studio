{
  "name": "aether-studio",
  "private": true,
  "version": "0.1.0-beta.9",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.desktop.json",
    "smoke": "node --import tsx scripts/smoke.ts",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:network": "node --import tsx scripts/smoke-network.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:runtime && node scripts/dev-desktop.mjs",
    "desktop:package": "npm run build && npm run build:desktop && npm run licenses && electron-builder --dir",
    "smoke:host": "node --import tsx scripts/smoke-host.ts",
    "smoke:recovery": "node --import tsx scripts/smoke-recovery.ts",
    "smoke:crash": "node scripts/smoke-crash.mjs",
    "smoke:desktop": "node scripts/smoke-electron.mjs",
    "licenses": "npm run desktop:runtime && node scripts/licenses.mjs",
    "desktop:runtime": "node node_modules/electron/install.js",
    "smoke:language": "node --import tsx scripts/smoke-language.ts",
    "smoke:terminal": "node --import tsx scripts/smoke-terminal.ts",
    "desktop:release": "npm run build && npm run build:desktop && npm run licenses && electron-builder --publish never",
    "smoke:release": "node scripts/smoke-release.mjs",
    "smoke:platformio": "node --import tsx scripts/smoke-platformio.ts",
    "smoke:esp32": "node --import tsx scripts/smoke-esp32.ts",
    "smoke:esp": "node --import tsx scripts/smoke-esp.ts",
    "smoke:esp:device": "node --import tsx scripts/smoke-esp-device.ts",
    "smoke:esp:preflight": "node --import tsx scripts/smoke-esp-device-preflight.ts",
    "smoke:esp:deploy-gate": "node --import tsx scripts/smoke-esp-deploy-gate.ts",
    "smoke:flash": "node --import tsx scripts/smoke-flash.ts",
    "smoke:micropython": "node --import tsx scripts/smoke-micropython.ts",
    "smoke:micropython:desktop": "node scripts/smoke-micropython-desktop.mjs",
    "smoke:micropython:files": "node --import tsx scripts/smoke-micropython-files.ts",
    "smoke:serial-log": "node --import tsx scripts/smoke-serial-log.ts",
    "smoke:micropython:files:desktop": "node scripts/smoke-micropython-files-desktop.mjs",
    "smoke:build-inputs": "node --import tsx scripts/smoke-build-inputs.ts",
    "smoke:build-review": "node --import tsx scripts/smoke-build-review.ts",
    "smoke:build-diagnostics": "node --import tsx scripts/smoke-build-diagnostics.ts",
    "smoke:provider": "node --import tsx scripts/smoke-provider.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "motion": "^12.23.12",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0",
    "tailwind-merge": "^2.6.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop-dist/main.mjs",
  "license": "Apache-2.0",
  "description": "Plugin-based open source hardware development workspace",
  "author": "Aether Studio contributors",
  "build": {
    "appId": "studio.aether.app",
    "productName": "Aether Studio",
    "files": [
      "dist/**/*",
      "desktop-dist/**/*",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "dist-licenses/**/*",
      "NOTICE"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "aether-studio"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "executableName": "AetherStudio"
    },
    "artifactName": "Aether-Studio-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "sign": false
    }
  }
}
