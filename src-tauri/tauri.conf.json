{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aether Studio",
  "version": "0.1.0",
  "identifier": "studio.aether.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether Studio",
        "width": 1728,
        "height": 1080,
        "minWidth": 1180,
        "minHeight": 760,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#F5F6F8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}